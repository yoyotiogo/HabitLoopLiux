{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jiri.example/design/collections.schema.json",
  "title": "积日数据集合设计（JSON 表示）",
  "$defs": {
    "RuleConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "score": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "FIXED"
                },
                "basePoints": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                }
              },
              "required": [
                "type",
                "basePoints"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "STREAK_STEP"
                },
                "basePoints": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "stepEveryDays": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 365
                },
                "stepPoints": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "maxPoints": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                }
              },
              "required": [
                "type",
                "basePoints",
                "stepEveryDays",
                "stepPoints",
                "maxPoints"
              ]
            }
          ]
        },
        "goal": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "POINTS_BALANCE",
                "SUCCESS_COUNT",
                "CONSECUTIVE_DAYS"
              ]
            },
            "target": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          "required": [
            "type",
            "target"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "enum": [
                      "SUCCESS_COUNT",
                      "CONSECUTIVE_DAYS"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "target": {
                    "maximum": 3650
                  }
                }
              }
            }
          ]
        },
        "completionMode": {
          "enum": [
            "ONCE",
            "REPEAT"
          ]
        },
        "reward": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string",
              "maxLength": 120
            },
            "budgetCents": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 100000000
            },
            "currency": {
              "const": "CNY"
            }
          },
          "required": [
            "description",
            "budgetCents",
            "currency"
          ]
        },
        "backfillWindowDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        }
      },
      "required": [
        "score",
        "goal",
        "completionMode",
        "reward",
        "backfillWindowDays"
      ]
    },
    "users": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_id": {
          "type": "string",
          "description": "内部用户编号。"
        },
        "appId": {
          "type": "string",
          "description": "绑定的小程序 AppID。"
        },
        "openId": {
          "type": "string",
          "description": "从微信云托管可信请求头获取。"
        },
        "status": {
          "type": "string",
          "description": "账号生命周期。",
          "enum": [
            "ACTIVE",
            "DELETING"
          ]
        },
        "defaultTimezone": {
          "type": "string",
          "description": "默认时区；新任务复制该值。"
        },
        "createdAt": {
          "type": "string",
          "description": "服务端 UTC 时间，固定毫秒精度。",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "最近更新的服务端 UTC 时间。",
          "format": "date-time"
        }
      },
      "required": [
        "_id",
        "appId",
        "openId",
        "status",
        "defaultTimezone",
        "createdAt",
        "updatedAt"
      ]
    },
    "tasks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_id": {
          "type": "string",
          "description": "文档主键；由服务端生成。"
        },
        "ownerUserId": {
          "type": "string",
          "description": "从可信微信身份映射得到；客户端不可指定。"
        },
        "title": {
          "type": "string",
          "description": "任务名称，1～40 个字符。",
          "minLength": 1,
          "maxLength": 40
        },
        "description": {
          "type": "string",
          "description": "用户定义的达标标准，最多 300 字。",
          "maxLength": 300
        },
        "icon": {
          "type": "string",
          "description": "预置图标编号。",
          "enum": [
            "leaf",
            "book",
            "moon",
            "walk",
            "coin",
            "star"
          ]
        },
        "timezone": {
          "type": "string",
          "description": "固定的 IANA 时区；创建后不能修改。"
        },
        "startDate": {
          "type": "string",
          "description": "首轮业务开始日期。",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        },
        "status": {
          "type": "string",
          "description": "暂停仍会因未打卡而中断连续状态。",
          "enum": [
            "ACTIVE",
            "PAUSED",
            "ARCHIVED",
            "DELETED"
          ]
        },
        "activeRoundId": {
          "type": "string",
          "description": "当前轮次 ID。"
        },
        "currentRuleId": {
          "type": "string",
          "description": "当前不可变规则版本 ID。"
        },
        "pendingRuleId": {
          "type": [
            "string",
            "null"
          ],
          "description": "下一轮生效的规则；无变更时为 null。"
        },
        "balancePoints": {
          "type": "integer",
          "description": "可用积分缓存；必须等于本任务流水净和。",
          "minimum": 0
        },
        "lastOnTimeSuccessDate": {
          "type": [
            "string",
            "null"
          ],
          "description": "最后一次准时成功日期；补卡不修改。"
        },
        "streakAtLastSuccess": {
          "type": "integer",
          "description": "最后一次准时成功时的实际连续长度。",
          "minimum": 0
        },
        "reminder": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "localTime": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            }
          },
          "required": [
            "enabled",
            "localTime"
          ]
        },
        "deletedAt": {
          "type": [
            "string",
            "null"
          ],
          "description": "软删除时间；30 天后清理任务相关文档。"
        },
        "revision": {
          "type": "integer",
          "description": "乐观锁版本；每次实际变更递增。",
          "minimum": 1
        },
        "createdAt": {
          "type": "string",
          "description": "服务端 UTC 时间，固定毫秒精度。",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "最近更新的服务端 UTC 时间。",
          "format": "date-time"
        }
      },
      "required": [
        "_id",
        "ownerUserId",
        "title",
        "description",
        "icon",
        "timezone",
        "startDate",
        "status",
        "activeRoundId",
        "currentRuleId",
        "pendingRuleId",
        "balancePoints",
        "lastOnTimeSuccessDate",
        "streakAtLastSuccess",
        "reminder",
        "deletedAt",
        "revision",
        "createdAt",
        "updatedAt"
      ]
    },
    "task_rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_id": {
          "type": "string",
          "description": "规则版本编号。"
        },
        "ownerUserId": {
          "type": "string",
          "description": "从可信微信身份映射得到；客户端不可指定。"
        },
        "taskId": {
          "type": "string",
          "description": "所属任务。"
        },
        "version": {
          "type": "integer",
          "description": "任务内规则版本，单调增加。",
          "minimum": 1
        },
        "config": {
          "$ref": "#/$defs/RuleConfig",
          "description": "完整规则对象。"
        },
        "createdAt": {
          "type": "string",
          "description": "服务端 UTC 时间，固定毫秒精度。",
          "format": "date-time"
        }
      },
      "required": [
        "_id",
        "ownerUserId",
        "taskId",
        "version",
        "config",
        "createdAt"
      ]
    },
    "rounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_id": {
          "type": "string",
          "description": "轮次编号。"
        },
        "ownerUserId": {
          "type": "string",
          "description": "从可信微信身份映射得到；客户端不可指定。"
        },
        "taskId": {
          "type": "string",
          "description": "所属任务。"
        },
        "sequence": {
          "type": "integer",
          "description": "任务内轮次号。",
          "minimum": 1
        },
        "ruleId": {
          "type": "string",
          "description": "固定引用的规则版本。"
        },
        "startDate": {
          "type": "string",
          "description": "本轮开始日期，新轮从确认完成的次日开始。",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        },
        "endDate": {
          "type": [
            "string",
            "null"
          ],
          "description": "确认完成日期，进行中为 null。"
        },
        "state": {
          "type": "string",
          "description": "本轮状态。",
          "enum": [
            "OPEN",
            "READY",
            "CLAIMED"
          ]
        },
        "successCount": {
          "type": "integer",
          "description": "本轮成功次数，包含合规补卡。",
          "minimum": 0
        },
        "currentGoalStreak": {
          "type": "integer",
          "description": "本轮准时成功形成的连续长度。",
          "minimum": 0
        },
        "maxGoalStreak": {
          "type": "integer",
          "description": "本轮曾达到的最长连续长度；连续目标以此判断。",
          "minimum": 0
        },
        "readyAt": {
          "type": [
            "string",
            "null"
          ],
          "description": "本轮首次达到条件的时间；当日撤销使条件不成立时清空。"
        },
        "revision": {
          "type": "integer",
          "description": "乐观锁版本；每次实际变更递增。",
          "minimum": 1
        },
        "createdAt": {
          "type": "string",
          "description": "服务端 UTC 时间，固定毫秒精度。",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "最近更新的服务端 UTC 时间。",
          "format": "date-time"
        }
      },
      "required": [
        "_id",
        "ownerUserId",
        "taskId",
        "sequence",
        "ruleId",
        "startDate",
        "endDate",
        "state",
        "successCount",
        "currentGoalStreak",
        "maxGoalStreak",
        "readyAt",
        "revision",
        "createdAt",
        "updatedAt"
      ]
    },
    "checkins": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_id": {
          "type": "string",
          "description": "SHA256(ownerUserId|taskId|businessDate)；与轮次无关。"
        },
        "ownerUserId": {
          "type": "string",
          "description": "从可信微信身份映射得到；客户端不可指定。"
        },
        "taskId": {
          "type": "string",
          "description": "所属任务。"
        },
        "roundId": {
          "type": "string",
          "description": "计入的轮次。"
        },
        "ruleId": {
          "type": "string",
          "description": "当次实际使用规则。"
        },
        "businessDate": {
          "type": "string",
          "description": "按任务固定时区划分的自然日。",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        },
        "outcome": {
          "type": "string",
          "description": "UNRECORDED 为撤销后的软记录，不计分。",
          "enum": [
            "SUCCESS",
            "FAILURE",
            "UNRECORDED"
          ]
        },
        "source": {
          "type": "string",
          "description": "补卡不给连续加成，也不恢复连续状态。",
          "enum": [
            "ON_TIME",
            "BACKFILL"
          ]
        },
        "awardedPoints": {
          "type": "integer",
          "description": "当前有效打卡获得的积分，失败/撤销为 0。",
          "minimum": 0
        },
        "streakAfter": {
          "type": "integer",
          "description": "准时成功时的实际连续天数；补卡为 0。",
          "minimum": 0
        },
        "previousStreakState": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lastOnTimeSuccessDate": {
              "type": [
                "string",
                "null"
              ]
            },
            "streakAtLastSuccess": {
              "type": "integer",
              "minimum": 0
            },
            "currentGoalStreak": {
              "type": "integer",
              "minimum": 0
            },
            "maxGoalStreak": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "lastOnTimeSuccessDate",
            "streakAtLastSuccess",
            "currentGoalStreak",
            "maxGoalStreak"
          ]
        },
        "note": {
          "type": "string",
          "description": "可选私密备注，最多 300 字。",
          "maxLength": 300
        },
        "revision": {
          "type": "integer",
          "description": "乐观锁版本；每次实际变更递增。",
          "minimum": 1
        },
        "createdAt": {
          "type": "string",
          "description": "服务端 UTC 时间，固定毫秒精度。",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "最近更新的服务端 UTC 时间。",
          "format": "date-time"
        }
      },
      "required": [
        "_id",
        "ownerUserId",
        "taskId",
        "roundId",
        "ruleId",
        "businessDate",
        "outcome",
        "source",
        "awardedPoints",
        "streakAfter",
        "previousStreakState",
        "note",
        "revision",
        "createdAt",
        "updatedAt"
      ]
    },
    "points_ledger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_id": {
          "type": "string",
          "description": "由业务来源、记录 ID、记录版本和流水类型生成。"
        },
        "ownerUserId": {
          "type": "string",
          "description": "从可信微信身份映射得到；客户端不可指定。"
        },
        "taskId": {
          "type": "string",
          "description": "所属任务的钱包。"
        },
        "roundId": {
          "type": "string",
          "description": "业务所属轮次。"
        },
        "kind": {
          "type": "string",
          "description": "获得、冲正或兑换。",
          "enum": [
            "CHECKIN_AWARD",
            "CHECKIN_REVERSAL",
            "GOAL_DEBIT"
          ]
        },
        "delta": {
          "type": "integer",
          "description": "正数获得、负数扣除；禁止 0。",
          "not": {
            "const": 0
          }
        },
        "balanceAfter": {
          "type": "integer",
          "description": "该条流水提交后的余额快照。",
          "minimum": 0
        },
        "sourceId": {
          "type": "string",
          "description": "关联 checkinId 或 claimId。"
        },
        "sourceRevision": {
          "type": "integer",
          "description": "对应业务记录版本。",
          "minimum": 1
        },
        "commandId": {
          "type": "string",
          "description": "对应幂等命令 ID。"
        },
        "createdAt": {
          "type": "string",
          "description": "服务端 UTC 时间，固定毫秒精度。",
          "format": "date-time"
        }
      },
      "required": [
        "_id",
        "ownerUserId",
        "taskId",
        "roundId",
        "kind",
        "delta",
        "balanceAfter",
        "sourceId",
        "sourceRevision",
        "commandId",
        "createdAt"
      ]
    },
    "goal_claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_id": {
          "type": "string",
          "description": "确定性主键：claim:roundId。"
        },
        "ownerUserId": {
          "type": "string",
          "description": "从可信微信身份映射得到；客户端不可指定。"
        },
        "taskId": {
          "type": "string",
          "description": "所属任务。"
        },
        "roundId": {
          "type": "string",
          "description": "被关闭的轮次。"
        },
        "ruleId": {
          "type": "string",
          "description": "兑换时规则版本。"
        },
        "goalSnapshot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "POINTS_BALANCE",
                "SUCCESS_COUNT",
                "CONSECUTIVE_DAYS"
              ]
            },
            "target": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          "required": [
            "type",
            "target"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "enum": [
                      "SUCCESS_COUNT",
                      "CONSECUTIVE_DAYS"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "target": {
                    "maximum": 3650
                  }
                }
              }
            }
          ]
        },
        "rewardSnapshot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string",
              "maxLength": 120
            },
            "budgetCents": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 100000000
            },
            "currency": {
              "const": "CNY"
            }
          },
          "required": [
            "description",
            "budgetCents",
            "currency"
          ]
        },
        "debitedPoints": {
          "type": "integer",
          "description": "积分目标扣目标值，次数/天数目标为 0。",
          "minimum": 0
        },
        "balanceAfter": {
          "type": "integer",
          "description": "兑换后余额。",
          "minimum": 0
        },
        "rewardRecord": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "note": {
              "type": "string",
              "maxLength": 300
            },
            "amountCents": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "note",
            "amountCents"
          ]
        },
        "claimedBusinessDate": {
          "type": "string",
          "description": "确认完成的业务日期。",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        },
        "nextRoundId": {
          "type": [
            "string",
            "null"
          ],
          "description": "一次性任务为 null；循环任务关联新轮。"
        },
        "createdAt": {
          "type": "string",
          "description": "服务端 UTC 时间，固定毫秒精度。",
          "format": "date-time"
        }
      },
      "required": [
        "_id",
        "ownerUserId",
        "taskId",
        "roundId",
        "ruleId",
        "goalSnapshot",
        "rewardSnapshot",
        "debitedPoints",
        "balanceAfter",
        "rewardRecord",
        "claimedBusinessDate",
        "nextRoundId",
        "createdAt"
      ]
    },
    "command_receipts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_id": {
          "type": "string",
          "description": "SHA256(ownerUserId|action|requestId)。"
        },
        "ownerUserId": {
          "type": "string",
          "description": "从可信微信身份映射得到；客户端不可指定。"
        },
        "action": {
          "type": "string",
          "description": "命令名。"
        },
        "requestId": {
          "type": "string",
          "description": "客户端生成并持久保存的 UUID。",
          "format": "uuid"
        },
        "payloadHash": {
          "type": "string",
          "description": "规范化 payload 的 SHA256；同 ID 换参数拒绝。",
          "pattern": "^[a-f0-9]{64}$"
        },
        "responseData": {
          "type": "object",
          "description": "不包含身份信息的原始业务成功结果。"
        },
        "createdAt": {
          "type": "string",
          "description": "服务端 UTC 时间，固定毫秒精度。",
          "format": "date-time"
        }
      },
      "required": [
        "_id",
        "ownerUserId",
        "action",
        "requestId",
        "payloadHash",
        "responseData",
        "createdAt"
      ]
    },
    "outbox_events": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_id": {
          "type": "string",
          "description": "由业务来源与事件类型确定。"
        },
        "ownerUserId": {
          "type": "string",
          "description": "从可信微信身份映射得到；客户端不可指定。"
        },
        "type": {
          "type": "string",
          "description": "异步事件类型。",
          "enum": [
            "EXPORT_REQUESTED",
            "ACCOUNT_DELETE_REQUESTED",
            "GOAL_REACHED"
          ]
        },
        "aggregateId": {
          "type": "string",
          "description": "来源任务/导出任务/用户 ID。"
        },
        "status": {
          "type": "string",
          "description": "worker 带租约领取；业务请求不等待执行。",
          "enum": [
            "PENDING",
            "PROCESSING",
            "DONE",
            "FAILED"
          ]
        },
        "attempts": {
          "type": "integer",
          "description": "已尝试次数，最多 5 次后进入人工排查。",
          "minimum": 0,
          "maximum": 5
        },
        "nextAttemptAt": {
          "type": "string",
          "description": "下次可执行 UTC 时间。",
          "format": "date-time"
        },
        "leaseUntil": {
          "type": [
            "string",
            "null"
          ],
          "description": "租约到期；未领取为 null。"
        },
        "payload": {
          "type": "object",
          "description": "最小事件信息，避免复制私密备注。"
        },
        "createdAt": {
          "type": "string",
          "description": "服务端 UTC 时间，固定毫秒精度。",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "最近更新的服务端 UTC 时间。",
          "format": "date-time"
        }
      },
      "required": [
        "_id",
        "ownerUserId",
        "type",
        "aggregateId",
        "status",
        "attempts",
        "nextAttemptAt",
        "leaseUntil",
        "payload",
        "createdAt",
        "updatedAt"
      ]
    },
    "export_jobs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_id": {
          "type": "string",
          "description": "导出任务编号。"
        },
        "ownerUserId": {
          "type": "string",
          "description": "从可信微信身份映射得到；客户端不可指定。"
        },
        "status": {
          "type": "string",
          "description": "异步任务状态。",
          "enum": [
            "PENDING",
            "RUNNING",
            "READY",
            "FAILED",
            "EXPIRED"
          ]
        },
        "format": {
          "type": "string",
          "description": "首版采用有版本号的 JSON。",
          "enum": [
            "JSON"
          ]
        },
        "schemaVersion": {
          "type": "integer",
          "description": "导出格式版本。",
          "minimum": 1
        },
        "fileId": {
          "type": [
            "string",
            "null"
          ],
          "description": "私有云存储文件标识；尚未完成为 null。"
        },
        "expiresAt": {
          "type": "string",
          "description": "文件 24 小时后清理；下载链接有效期 10 分钟。",
          "format": "date-time"
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ],
          "description": "失败原因代码。"
        },
        "createdAt": {
          "type": "string",
          "description": "服务端 UTC 时间，固定毫秒精度。",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "最近更新的服务端 UTC 时间。",
          "format": "date-time"
        }
      },
      "required": [
        "_id",
        "ownerUserId",
        "status",
        "format",
        "schemaVersion",
        "fileId",
        "expiresAt",
        "errorCode",
        "createdAt",
        "updatedAt"
      ]
    },
    "notification_jobs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_id": {
          "type": "string",
          "description": "用户 + 模板 + 业务日期的确定性主键。"
        },
        "ownerUserId": {
          "type": "string",
          "description": "从可信微信身份映射得到；客户端不可指定。"
        },
        "businessDate": {
          "type": "string",
          "description": "待提醒的业务日期。",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        },
        "templateId": {
          "type": "string",
          "description": "平台批准的实际模板 ID。"
        },
        "dueAt": {
          "type": "string",
          "description": "按用户配置时区换算的 UTC 时间。",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "description": "UNKNOWN 表示超时后发送结果不确定。",
          "enum": [
            "PENDING",
            "SENT",
            "SKIPPED",
            "FAILED",
            "UNKNOWN"
          ]
        },
        "taskIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "当天仍未记录的任务；发送前重新读取。"
        },
        "platformMessageId": {
          "type": [
            "string",
            "null"
          ],
          "description": "成功时保存平台返回标识。"
        },
        "lastErrorCode": {
          "type": [
            "string",
            "null"
          ],
          "description": "权限不足等平台错误。"
        },
        "createdAt": {
          "type": "string",
          "description": "服务端 UTC 时间，固定毫秒精度。",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "最近更新的服务端 UTC 时间。",
          "format": "date-time"
        }
      },
      "required": [
        "_id",
        "ownerUserId",
        "businessDate",
        "templateId",
        "dueAt",
        "status",
        "taskIds",
        "platformMessageId",
        "lastErrorCode",
        "createdAt",
        "updatedAt"
      ]
    }
  }
}
